# For a backend running directly on the host (not Docker Compose).
# Copy this file to `.env` and adjust the values. `.env` is gitignored —
# never commit real credentials. The Docker Compose stack uses the root
# `.env` instead and connects to the `mysql` service hostname.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/task_planner?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/task_planner_test?charset=utf8mb4
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
TOKEN_TTL_DAYS=30

# development | production (production requires a real SECRET_KEY)
ENVIRONMENT=development
# Comma-separated trusted origins, or * for local development.
CORS_ORIGINS=*
# Local convenience. Use Alembic for shared databases and set this to false.
CREATE_SCHEMA_ON_STARTUP=true

# Shared development database (only for authorized developers):
# - set DATABASE_URL to the shared host and keep CREATE_SCHEMA_ON_STARTUP=false;
# - never point TEST_DATABASE_URL at a shared database (tests truncate tables);
# - do not run Alembic against shared data without explicit authorization.
