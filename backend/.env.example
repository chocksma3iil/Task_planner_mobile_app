# For a backend running directly on the host (not Docker Compose).
# Copy this file to `.env` and adjust the values. `.env` is gitignored —
# never commit real credentials. The Docker Compose stack uses the root
# `.env` instead and connects to the `mysql` service hostname.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/task_planner?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/task_planner_test?charset=utf8mb4
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
TOKEN_TTL_DAYS=30
# Analytics activity older than this is pruned by the maintenance command.
ANALYTICS_RETENTION_DAYS=365
# Failed-login throttle (per client address + email).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# Password-reset codes are single-use and expire after this many minutes.
PASSWORD_RESET_TTL_MINUTES=30

# development | production (production requires a real SECRET_KEY)
ENVIRONMENT=development
# Comma-separated trusted origins, or * for local development.
CORS_ORIGINS=*
# Local convenience. Use Alembic for shared databases and set this to false.
CREATE_SCHEMA_ON_STARTUP=true

# Shared development database (only for authorized developers):
# - set DATABASE_URL to the shared host and keep CREATE_SCHEMA_ON_STARTUP=false;
# - never point TEST_DATABASE_URL at a shared database (tests truncate tables);
# - do not run Alembic against shared data without explicit authorization.

# SMTP email notifications (leave unset to disable emails in dev).
# Gmail: use an App Password (Google Account > Security > 2-Step Verification
# > App passwords), not your normal password. Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=the-16-character-app-password
#   SMTP_FROM=you@gmail.com
#   SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true

# AI layer (v2.0). Only used when the backend runs directly on the host.
# Ollama must be running and the model must be pulled (`ollama pull llama3.2`).
# A 3B model is the safe default for 8-16 GB machines; a 7B model needs
# roughly 5 GB of free RAM (or a GPU with enough VRAM) to start.
AI_PROVIDER=ollama
AI_MODEL=llama3.2:latest
AI_BASE_URL=http://localhost:11434
AI_TIMEOUT_SECONDS=180
