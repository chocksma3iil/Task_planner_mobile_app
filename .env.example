# Local Docker Compose development only.
# Copy to `.env` and replace every placeholder before starting the stack.
# Never use these values for a shared or production environment.

MYSQL_ROOT_PASSWORD=change-me-local-root-password
MYSQL_PASSWORD=change-me-local-db-password
SECRET_KEY=change-me-local-secret-at-least-32-bytes

# Host ports. Services bind to 127.0.0.1 by default.
API_PORT=8000
PHPMYADMIN_PORT=8080
PHPMYADMIN_BIND=127.0.0.1

# Set to 0.0.0.0 only when a device on your trusted LAN must reach the API.
API_BIND=127.0.0.1
